{
  "name": "@circuit-breaker/cli",
  "version": "0.1.0",
  "description": "CLI for Circuit Breaker workflow orchestration",
  "type": "module",
  "bin": {
    "cb": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --external commander --external chalk --external ora --external ink --external ink-spinner --external ink-select-input --external ink-text-input --external react --external nats",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "fmt": "prettier --write src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@circuit-breaker/core": "workspace:*",
    "chalk": "^5.3.0",
    "yaml": "2.8.3",
    "commander": "^12.0.0",
    "ink": "6.6.0",
    "ink-select-input": "6.2.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "nats": "2.29.3",
    "ora": "^8.0.0",
    "react": "19"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "@types/react": "19.2.10",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "circuit-breaker",
    "cli",
    "workflow",
    "petri-net",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/circuit-breaker/circuit-breaker.git",
    "directory": "sdk/packages/cli"
  },
  "license": "MIT"
}
